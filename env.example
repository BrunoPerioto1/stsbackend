# Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_NAME=betting_tracker
DB_PASSWORD=your_password_here
DB_PORT=5432

# Auth
JWT_SECRET=change_me_to_a_long_random_string

# Telegram Bot (optional — only needed to run the bot)
TELEGRAM_BOT_TOKEN=your_bot_token_here
APP_URL=https://your-public-url.example.com
API_URL=http://localhost:4000

# Chat ID of the "Tips" group (same value as DESTINATION_GROUP_ID in the
# repasse repo). The bot must be an admin of this group (or have Privacy
# Mode disabled via @BotFather) to read the tip messages posted there and
# fan them out per-user based on each user's min_percent_filter.
TIPS_GROUP_CHAT_ID=

# Groq API (optional — only needed to run the bot's message parsing)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI (optional — only needed for bet recognition from screenshots sent
# to the bot as a photo + caption with the bookmaker name)
OPENAI_API_KEY=
