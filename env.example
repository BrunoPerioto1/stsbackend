# Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_NAME=betting_tracker
DB_PASSWORD=your_password_here
DB_PORT=5432
# SSL do pool. Sem nada: localhost sem SSL, qualquer outro host com SSL (sem
# verificar o certificado). Com DB_SSL_CA_BASE64 (certificado do painel do
# Supabase, em base64) o servidor e' verificado. DB_SSL=disable desliga.
DB_SSL=
DB_SSL_CA_BASE64=

# Auth
JWT_SECRET=change_me_to_a_long_random_string

# Telegram Bot (optional — only needed to run the bot)
TELEGRAM_BOT_TOKEN=your_bot_token_here
APP_URL=https://your-public-url.example.com
API_URL=http://localhost:4000
# Segredo do webhook (16-256 caracteres: letras, numeros, _ e -). Vai no
# setWebhook e o Telegram devolve em header; o token do bot sai da URL.
# Depois de definir, rode: npm run telegram:webhook
TELEGRAM_WEBHOOK_SECRET=

# Endereco do front (links do bot e CORS). CORS_ORIGINS, se definido,
# substitui a lista de origens liberadas (separadas por virgula).
FRONT_URL=https://stsfront.vercel.app
CORS_ORIGINS=

# Chat ID do grupo "Tips". O bot precisa ser admin desse grupo (ou estar com o
# Privacy Mode desligado no @BotFather) para ler as tips postadas ali e
# distribuir por usuario conforme o min_percent_filter de cada um.
# Pra barrar quem nao pagou (entrada por pedido, "Tirar do grupo" no painel),
# o bot tambem precisa de "Banir usuarios" e "Convidar via link" — ver
# docs/telegram-operations.md.
TIPS_GROUP_CHAT_ID=

# Groq API (optional — only needed to run the bot's message parsing)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI (optional — only needed for bet recognition from screenshots sent
# to the bot as a photo + caption with the bookmaker name)
OPENAI_API_KEY=

# Cobranca manual por PIX. PIX_KEY/ACCESS_PRICE aparecem na tela de acesso
# vencido e no aviso do Telegram. TRIAL_DAYS = dias gratis de conta nova (0 =
# nasce bloqueada ate o admin liberar). CRON_SECRET protege /access/cron (a
# Vercel manda como Bearer quando a env existe no projeto).
PIX_KEY=43708613-c76d-4199-97a0-a59d9c785f3b
ACCESS_PRICE=40
# Nome e cidade do recebedor no PIX copia-e-cola (BR Code). Sem acento; o
# padrao corta em 25 e 15 caracteres.
PIX_MERCHANT_NAME=SportsBet Manager
PIX_MERCHANT_CITY=Sao Paulo
TRIAL_DAYS=0
CRON_SECRET=
